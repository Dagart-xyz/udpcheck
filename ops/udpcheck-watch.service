[Unit]
Description=udpcheck: наблюдатель (проверка хаба и серверов, оповещения)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=udpcheck-watch
EnvironmentFile=/etc/udpcheck-watch.env
ExecStart=/usr/bin/python3 /opt/udpcheck-watch/udpcheck-watch.py
TimeoutStartSec=50
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=64M
