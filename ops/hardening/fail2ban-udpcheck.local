# fail2ban для SSH с нарастающим баном: первый бан час, при повторах 2, 4, 8, 16, 32, 64 часа, потолок 4 недели.
# Положить в /etc/fail2ban/jail.d/udpcheck.local и перезапустить fail2ban. На Ubuntu и Debian юнит SSH называется ssh.service.
[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
backend = systemd
bantime.increment = true
bantime.multipliers = 1 2 4 8 16 32 64
bantime.maxtime = 4w
bantime.overalljails = true

[sshd]
enabled = true
port = ssh
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd
