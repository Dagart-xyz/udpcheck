# Хаб слушает только 127.0.0.1:18080. Простаивающие соединения к нему закрываем раньше, чем он сам (у него таймаут 20 с): иначе Caddy иногда
# берёт уже закрытое соединение и запрос (особенно POST серверов-целей) обрывается с EOF.
(hub) {
	reverse_proxy 127.0.0.1:18080 {
		transport http {
			keepalive 10s
		}
	}
}

dagart.xyz {
	# Хаб: API проекта (старый префикс /udpcheck оставлен для уже установленных узлов и целей)
	handle /udpcheck/* {
		import hub
	}
	handle /api/* {
		import hub
	}

	# Проект: лендинг и кнопка проверки в корне сайта
	handle {
		root * /var/www/udpcheck-site
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			# страницу браузер каждый раз сверяет с сервером (иначе у посетителей остаётся старая версия); картинки кэшируются ниже
			Cache-Control no-cache
			Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
		}
		rewrite /i /install-node.sh
		# страницы провайдеров /as29124: та же страница, дальше работает JS
		@prov path_regexp ^/as[0-9]{1,10}/?$
		rewrite @prov /index.html
		@sh path /install-node.sh /i
		header @sh Content-Type "text/plain; charset=utf-8"
		@static path /logos/*
		header @static Cache-Control "public, max-age=86400"
		file_server
	}

	log {
		output discard
	}
}
