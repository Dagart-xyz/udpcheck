# Ограничения против медленных и гигантских запросов (боты, сканеры): заголовок и тело читаются недолго, заголовки небольшие.
# write 60s: хаб держит ответ до 25 с (длинный опрос серверов-целей).
{
	servers {
		timeouts {
			read_header 10s
			read_body 20s
			write 60s
			idle 2m
		}
		max_header_size 16KB
	}
}

# Хаб слушает только 127.0.0.1:18080. Простаивающие соединения к нему закрываем раньше, чем он сам (у него таймаут 20 с): иначе Caddy иногда
# берёт уже закрытое соединение и запрос (особенно POST серверов-целей) обрывается с EOF.
(hub) {
	request_body {
		max_size 64KB
	}
	reverse_proxy 127.0.0.1:18080 {
		# тело до 64 КБ буферизуется, и хабу уходит заголовок Content-Length (он не читает Transfer-Encoding)
		request_buffers 64KB
		transport http {
			keepalive 10s
		}
	}
}

dagart.xyz {
	# Сжатие страниц и JSON (страница 97 КБ, список провайдеров 62 КБ) и защитные заголовки для всех ответов, включая API
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# Хаб: API проекта (старый префикс /udpcheck оставлен для уже установленных узлов и целей)
	handle /udpcheck/* {
		import hub
	}
	handle /api/* {
		import hub
	}

	# Проект: лендинг и кнопка проверки в корне сайта
	handle {
		root * /var/www/udpcheck-site
		header {
			# страницу браузер каждый раз сверяет с сервером (иначе у посетителей остаётся старая версия); картинки кэшируются ниже
			Cache-Control no-cache
			Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
		}
		rewrite /i /install-node.sh
		# страницы документов без расширения
		@docs path /privacy /terms
		rewrite @docs {path}.html
		# страницы провайдеров /as29124: та же страница, дальше работает JS
		@prov path_regexp ^/as[0-9]{1,10}/?$
		rewrite @prov /index.html
		@sh path /install-node.sh /i
		header @sh Content-Type "text/plain; charset=utf-8"
		@static path /logos/*
		header @static Cache-Control "public, max-age=86400"
		file_server
	}

	log {
		output discard
	}
}
